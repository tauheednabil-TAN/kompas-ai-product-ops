# --- Required (C8: these two are the only required vars) ---

# Google Gemini API key — https://aistudio.google.com/apikey
# Server-side only. Never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Neon Postgres connection string — https://console.neon.tech
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/kompas?sslmode=require
DATABASE_URL=

# --- Optional, everything below degrades gracefully ---

# Set to "true" on the public demo deployment. Forces the cheap model tier and
# enables a strict per-IP rate limit so a shared link cannot drain the key.
DEMO_MODE=

# Enables the "Åbn PR på GitHub" button in Færdigheder. If unset, the button is
# hidden entirely rather than shown broken.
GITHUB_TOKEN=
GITHUB_SKILLS_REPO=
